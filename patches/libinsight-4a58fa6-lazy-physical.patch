+def test_lazy_physical_corruption_and_replaced_snapshot_are_not_fabricated(tmp_path):
+    app, out = _lef_only_app(tmp_path)
+    path = os.path.join(out, "physical.json")
+    with open(path, "w") as f:
+        f.write('{"schema":"lib-insight-physical/1","scope_kind":"library-physical","supplied":true,"masters":[BROKEN]}')
+    app = App(app.config_path)
+    status, _, body = app.handle("GET", "/api/physical", {"kit": "lefonly"}, {})
+    assert status == 400 and b"JSONDecodeError" in body
+    # A new valid physical result after this App's snapshot must require reload, not mix snapshots.
+    replacement = path + ".replacement"
+    with open(replacement, "w") as f:
+        json.dump({"schema": "lib-insight-physical/1", "scope_kind": "library-physical",
+                   "supplied": False}, f)
+    os.replace(replacement, path)
+    status, _, body = app.handle("GET", "/api/physical", {"kit": "lefonly"}, {})
+    assert status == 409 and b"changed on disk" in body
+
+
