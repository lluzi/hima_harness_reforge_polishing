+def test_first_concurrent_physical_reads_share_one_payload_and_index(tmp_path, monkeypatch):
+    from concurrent.futures import ThreadPoolExecutor
+    app, out = _lef_only_app(tmp_path)
+    app = App(app.config_path)
+    kd = app.kit({"kit": "lefonly"})
+    reads = []
+    original = json.load
+    def counted(f, *args, **kwargs):
+        if str(getattr(f, "name", "")).endswith("physical.json"):
+            reads.append(f.name)
+        return original(f, *args, **kwargs)
+    monkeypatch.setattr(json, "load", counted)
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        indexes = list(pool.map(lambda _: kd.physical_index(), range(8)))
+    assert all(index is indexes[0] for index in indexes)
+    assert len(reads) == 1, "concurrent first access must parse only one payload"
+    assert _get(app, "/api/physical/master", kit="lefonly", cell="CELLA")["master"]["pcell"] == {
+        "n": 9, "d": 16, "approx": 0.5625}
+
