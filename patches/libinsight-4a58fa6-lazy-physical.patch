+@pytest.mark.parametrize("layout", ["false", "reordered", "nested", "long-header", "missing"])
+def test_physical_availability_preserves_real_false_old_layout_and_absence(tmp_path, layout):
+    app, out = _lef_only_app(tmp_path)
+    path = os.path.join(out, "physical.json")
+    with open(path) as f:
+        original = json.load(f)
+    if layout == "missing":
+        os.unlink(path)
+    else:
+        value = dict(original, supplied=False)
+        if layout == "reordered":
+            value = {"masters": value.pop("masters"), **value}
+        elif layout == "nested":
+            value = {"schema": value.pop("schema"), "scope_kind": value.pop("scope_kind"),
+                     "metadata": {"supplied": True}, **value}
+        elif layout == "long-header":
+            value["schema"] = "x" * 5000
+        with open(path, "w") as f:
+            json.dump(value, f)
+    app = App(app.config_path)
+    assert _get(app, "/api/kits")[0]["has_physical"] is False
+    assert _get(app, "/api/physical", kit="lefonly")["supplied"] is False
+
