+    @staticmethod
+    def _physical_file_stamp(stat):
+        return stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns
+
+    def _physical_supplied(self) -> bool:
+        """Read the normal producer's small leading fields, not its masters. Old layouts use the original reader."""
+        try:
+            f = open(self._physical_path)
+        except FileNotFoundError:
+            self._physical_loaded = True
+            return False
+        with f:
+            self._physical_stamp = self._physical_file_stamp(os.fstat(f.fileno()))
+            prefix = f.read(4096)
+            decoder = json.JSONDecoder()
+            pos = 0
+            def whitespace():
+                nonlocal pos
+                while pos < len(prefix) and prefix[pos] in " \t\r\n":
+                    pos += 1
+            try:
+                whitespace()
+                if prefix[pos:pos + 1] != "{":
+                    raise ValueError("not a producer object")
+                pos += 1
+                for expected in ("schema", "scope_kind", "supplied"):
+                    whitespace()
+                    key, pos = decoder.raw_decode(prefix, pos)
+                    if key != expected:
+                        raise ValueError("older field order")
+                    whitespace()
+                    if prefix[pos:pos + 1] != ":":
+                        raise ValueError("missing colon")
+                    pos += 1
+                    whitespace()
+                    value, pos = decoder.raw_decode(prefix, pos)
+                    whitespace()
+                    if expected == "supplied":
+                        if not isinstance(value, bool) or prefix[pos:pos + 1] not in (",", "}"):
+                            raise ValueError("not a complete supplied boolean")
+                        return value
+                    if not isinstance(value, str) or prefix[pos:pos + 1] != ",":
+                        raise ValueError("older header layout")
+                    pos += 1
+            except ValueError:
+                pass
+            f.seek(0)
+            self._physical = json.load(f)
+            self._physical_loaded = True
+            return self._physical is not None and bool(self._physical.get("supplied"))
+
+    @property
+    def physical(self) -> Optional[dict]:
+        with self.lock:
+            if not self._physical_loaded:
+                self._assert_derived_unchanged()
+                try:
