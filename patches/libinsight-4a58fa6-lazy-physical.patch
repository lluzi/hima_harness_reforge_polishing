+                        if self._physical_file_stamp(os.fstat(f.fileno())) != self._physical_stamp:
+                            raise HttpError(409, "the physical result changed on disk; reload to see it")
+                        physical = json.load(f)
+                        if (self._physical_file_stamp(os.fstat(f.fileno())) != self._physical_stamp or
+                                self._physical_file_stamp(os.stat(self._physical_path)) != self._physical_stamp):
+                            raise HttpError(409, "the physical result changed on disk; reload to see it")
+                except FileNotFoundError:
