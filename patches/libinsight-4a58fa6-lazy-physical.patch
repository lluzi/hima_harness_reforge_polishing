+# Development dependency regression: normal electrical startup must not parse physical masters.
+def test_normal_electrical_pages_defer_physical_and_first_pin_access_loads_once(tmp_path, monkeypatch):
+    from app import server
+    app, kit, out = _physical_mini_app(tmp_path)
+    reads = []
+    original = json.load
+    def counted(f, *args, **kwargs):
+        if str(getattr(f, "name", "")).endswith("physical.json"):
+            reads.append(f.name)
+        return original(f, *args, **kwargs)
+    monkeypatch.setattr(json, "load", counted)
+    app = App(app.config_path)
+    assert reads == [], "App startup must not parse the full physical payload"
+    assert _get(app, "/api/kits")[0]["has_physical"] is True
+    health = _get(app, "/api/health", kit="mini")
+    overall = _get(app, "/api/overall", kit="mini")
+    assert health["identity"] == overall["identity"]
+    assert reads == [], "default Health/Overall must not parse physical masters"
+    physical = _get(app, "/api/physical", kit="mini")
+    assert physical["supplied"] is True and physical["pin_access"]["total"] > 0
+    assert "masters" not in physical
+    _get(app, "/api/physical/rows", kit="mini")
+    _get(app, "/api/physical/master", kit="mini", cell=physical["rows"][0]["cell"])
+    assert len(reads) == 1
+
