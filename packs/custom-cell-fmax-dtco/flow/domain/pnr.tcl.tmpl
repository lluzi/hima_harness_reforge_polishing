# Innovus place-and-route template for one arm of the current-process generated-standard-cell flow.
#
# PROVENANCE. Derived from the site-bound template site_bound_process/scripts/pnr_current_process.tcl. The step
# ordering is the Site profile's declared ordering, including the current physical-method
# assumptions:
#   addWellTap  the declared tap cell and interval are valid for this library before placement
#   DCAP insertion is intentionally disabled; trial.8 proved a checkerboard can consume the core
#   ordinary filler is intentionally omitted for this setup-only Campaign
#   streamOut   GDS, using the site-bound layer map
# Every site path is a placeholder that flow/bin/build_arm_scripts.py fills from the run input
# binding, and BOTH ARMS ARE GENERATED FROM THIS ONE TEMPLATE with only the arm name, the input
# checkpoint and the report directory differing. A matched-script assertion is recorded so an arm
# difference can never be a script difference.
#
# SCOPE. This template runs verify_drc and verifyConnectivity as the shared script did, for the
# route report only. It is NOT the geometry gate. The geometry gate runs in its own virgin
# session (flow/scripts/checker_session.tcl.tmpl), because a checker invoked a second time in a
# session that has already run one is incremental and under-reports.
#
# Placeholders: @@ARM@@ @@INIT_DB@@ @@PLACE_DB@@ @@DESIGN_TOP@@ @@MULTI_CPU@@ @@TAP_CELL@@ @@TAP_INTERVAL@@
#   @@MAX_EFFECTIVE_DENSITY@@ @@FLOORPLAN_UTILIZATION@@ @@PG_HORIZONTAL_LAYER@@ @@PG_VERTICAL_LAYER@@
#   @@PG_RING_WIDTH_UM@@ @@PG_RING_SPACING_UM@@ @@PG_STRIPE_WIDTH_UM@@
#   @@PG_STRIPE_SPACING_UM@@ @@PG_STRIPE_SET_DISTANCE_UM@@ @@PG_STRIPE_START_OFFSET_UM@@
#   @@RPT_DIR@@ @@FINAL_DB@@ @@GDS_OUT@@ @@GDS_MAP@@ @@MERGE_GDS@@
#   @@SWITCHING_ACTIVITY@@ @@CLOCK_BUFFER_CELLS@@ @@CLOCK_INVERTER_CELLS@@
#   @@POSTROUTE_NETLIST@@ is the routed logical graph used by the next research generation
#   @@ENDPOINT_INDEX@@ and @@ENDPOINT_REPORT@@ retain one worst setup path for every register data pin
#   dedicated pin-setup and pin-capture lines implement baseline placement or generated-arm replay

restoreDesign @@INIT_DB@@ @@DESIGN_TOP@@
setMultiCpuUsage -localCpu @@MULTI_CPU@@
file mkdir @@RPT_DIR@@
setAnalysisMode -analysisType onChipVariation -cppr both -usefulSkew true

# Matched Early Clock / useful-skew policy.  0.100 is in ns and therefore
# bounds borrowed slack to 100 ps.  Both arms are generated from this template.
setOptMode -opt_skew true -opt_skew_pre_cts true \
  -opt_skew_ccopt standard -opt_skew_post_route true
setUsefulSkewMode -opt_skew_max_allowed_delay 0.100 \
  -opt_skew_apply_delay_limits_to_full_flow true \
  -opt_skew_delay_pre_cts true
puts "=== CCFMAX USEFUL_SKEW_ENABLED [getAnalysisMode -usefulSkew] ==="
puts "=== CCFMAX USEFUL_SKEW_MAX_ALLOWED_DELAY [getUsefulSkewMode -opt_skew_max_allowed_delay] ns ==="

# Keep the clock tree on the Site-declared balanced clock Cells. These are
# common A/B inputs; the generated data-path library remains the sole arm
# difference. use_inverters lets CCOpt balance rise/fall with the matching
# DCCK inverter family instead of silently selecting ordinary data buffers.
set _ccfmax_clock_buffers [list @@CLOCK_BUFFER_CELLS@@]
set _ccfmax_clock_inverters [list @@CLOCK_INVERTER_CELLS@@]
set_ccopt_property buffer_cells $_ccfmax_clock_buffers
set_ccopt_property inverter_cells $_ccfmax_clock_inverters
set_ccopt_property use_inverters true
puts "=== CCFMAX CTS BUFFER CELLS $_ccfmax_clock_buffers ==="
puts "=== CCFMAX CTS INVERTER CELLS $_ccfmax_clock_inverters ==="

# --- pre-placement standard-cell area budget ---------------------------------------
# Every standard cell fixed into this core before logic placement consumes the same
# area the effective-density ceiling bounds.  The init stage sized the floorplan for
# @@FLOORPLAN_UTILIZATION@@ of the logic area, so the fixed tap plan is checked
# against the ceiling here: a plan that cannot fit is a planning error, not a long
# Innovus placement that ends in IMPSP-2002/IMPSP-2021.
proc _hima_standard_cell_area {} {
  set _area 0.0
  foreach _size [dbGet top.insts.cell.size] {
    set _width [lindex $_size 0]
    set _height [lindex $_size 1]
    if {[string is double -strict $_width] && [string is double -strict $_height]} {
      set _area [expr {$_area + $_width * $_height}]
    }
  }
  return $_area
}
set _hima_budget_core_box [lindex [dbGet top.fPlan.coreBox] 0]
if {[llength $_hima_budget_core_box] != 4} {
  error "V5 floorplan has no unique four-coordinate core box"
}
set _hima_budget_core_area [expr {([lindex $_hima_budget_core_box 2] - [lindex $_hima_budget_core_box 0]) * ([lindex $_hima_budget_core_box 3] - [lindex $_hima_budget_core_box 1])}]
set _hima_logic_area [_hima_standard_cell_area]
set _hima_logic_occupancy [expr {$_hima_logic_area / $_hima_budget_core_area}]
if {$_hima_logic_occupancy > (1.0 + 1.0e-9)} {
  error "V5 logic occupancy $_hima_logic_occupancy exceeds 100% before any fixed cell was added (requested floorplan utilization @@FLOORPLAN_UTILIZATION@@)"
}
puts "=== CCFMAX V5 LOGIC OCCUPANCY @@ARM@@ $_hima_logic_occupancy ==="

# --- profile-declared well taps, before placement ---
addWellTap -cell @@TAP_CELL@@ -cellInterval @@TAP_INTERVAL@@ -prefix WELLTAP
puts "=== CCFMAX well taps placed @@ARM@@ ==="

# Trial.8 inserted 33,215 fixed DCAP instances and consumed nearly the whole core.
# This reference method therefore inserts no DCAP.  Power planning remains real through
# the matched ring/stripe/sroute mesh, and both arms retain the zero count as evidence.
set _hima_dcap_count 0
puts "=== CCFMAX V5 DCAP COUNT @@ARM@@ $_hima_dcap_count ==="
set _hima_planned_area [_hima_standard_cell_area]
set _hima_fixed_cell_area [expr {$_hima_planned_area - $_hima_logic_area}]
if {$_hima_fixed_cell_area < 0} {
  error "V5 fixed tap area is invalid"
}
set _hima_planned_occupancy [expr {$_hima_planned_area / $_hima_budget_core_area}]
if {$_hima_planned_occupancy > (1.0 + 1.0e-9)} {
  error "V5 planned site occupancy $_hima_planned_occupancy exceeds 100% before placement: the fixed tap plan does not fit the core sized for utilization @@FLOORPLAN_UTILIZATION@@"
}
puts "=== CCFMAX V5 PLANNED OCCUPANCY @@ARM@@ $_hima_planned_occupancy ==="
puts "=== CCFMAX V5 FIXED CELL AREA @@ARM@@ $_hima_fixed_cell_area ==="

# A real, matched block-level power grid.  IR/EM signoff is outside this
# experiment; the grid establishes actual routing/resource competition.
globalNetConnect {@@PWR_NET@@} -type pgpin -pin {@@PWR_NET@@} -all
globalNetConnect {@@GND_NET@@} -type pgpin -pin {@@GND_NET@@} -all
addRing -nets {@@PWR_NET@@ @@GND_NET@@} -type core_rings -follow core \
  -layer {top @@PG_HORIZONTAL_LAYER@@ bottom @@PG_HORIZONTAL_LAYER@@ left @@PG_VERTICAL_LAYER@@ right @@PG_VERTICAL_LAYER@@} \
  -width @@PG_RING_WIDTH_UM@@ -spacing @@PG_RING_SPACING_UM@@ -offset @@PG_RING_SPACING_UM@@
addStripe -nets {@@PWR_NET@@ @@GND_NET@@} -layer @@PG_VERTICAL_LAYER@@ -direction vertical \
  -width @@PG_STRIPE_WIDTH_UM@@ -spacing @@PG_STRIPE_SPACING_UM@@ \
  -set_to_set_distance @@PG_STRIPE_SET_DISTANCE_UM@@ -start_offset @@PG_STRIPE_START_OFFSET_UM@@
sroute -connect {corePin floatingStripe} -allowLayerChange 1 -allowJogging 1
puts "=== CCFMAX V5 PG MESH @@ARM@@ @@PG_HORIZONTAL_LAYER@@/@@PG_VERTICAL_LAYER@@ ==="

@@PIN_SETUP@@
setPlaceMode -place_global_max_density @@MAX_EFFECTIVE_DENSITY@@
setOptMode -opt_max_density @@MAX_EFFECTIVE_DENSITY@@
set _hima_frozen_core_box [lindex [dbGet top.fPlan.coreBox] 0]
if {[llength $_hima_frozen_core_box] != 4} {
  error "V5 floorplan has no unique four-coordinate core box"
}
place_opt_design
# Compute the effective standard-cell occupancy from every instantiated master,
# including fixed tap cells.  Pure-gate density remains a separate report.
set _hima_occupied_area [_hima_standard_cell_area]
set _hima_core_box $_hima_frozen_core_box
set _hima_core_area [expr {([lindex $_hima_core_box 2] - [lindex $_hima_core_box 0]) * ([lindex $_hima_core_box 3] - [lindex $_hima_core_box 1])}]
set _hima_effective_occupancy [expr {$_hima_occupied_area / $_hima_core_area}]
if {$_hima_effective_occupancy > (1.0 + 1.0e-9)} {
  error "V5 effective site occupancy exceeds 100%: $_hima_effective_occupancy"
}
set _hima_physical_facts [open {@@PHYSICAL_FACTS@@} w]
puts $_hima_physical_facts "metric\tvalue\tunit"
puts $_hima_physical_facts "occupied_standard_cell_area\t$_hima_occupied_area\tum2"
puts $_hima_physical_facts "core_area\t$_hima_core_area\tum2"
puts $_hima_physical_facts "effective_site_occupancy\t$_hima_effective_occupancy\tfraction"
puts $_hima_physical_facts "dcap_count\t$_hima_dcap_count\tcount"
puts $_hima_physical_facts "pg_special_wire_count\t[llength [dbGet top.nets.sWires]]\tcount"
close $_hima_physical_facts
reportDensityMap > {@@DENSITY_REPORT@@}
puts "=== CCFMAX V5 EFFECTIVE OCCUPANCY @@ARM@@ $_hima_effective_occupancy ==="
# This is the CCEI branch point.  It precedes CTS/route and is retained with
# its own identity; generated/reference continuations must start here.
saveDesign @@PLACE_DB@@
puts "=== CCFMAX PLACE CHECKPOINT @@ARM@@ @@PLACE_DB@@ ==="
@@PIN_CAPTURE@@
# Split CTS construction from post-CTS setup optimization. Innovus's monolithic
# clock_opt_design can drive an unconstrained internal optimization into a density
# collapse. The doubled floorplan supplies headroom without imposing a local
# max-density setting; the explicit postCTS pass retains setup optimization and
# useful-skew policy, followed by the common effective-occupancy result check.
clock_opt_design -cts
optDesign -postCTS -setup
set _hima_post_cts_occupancy [expr {[_hima_standard_cell_area] / $_hima_core_area}]
if {$_hima_post_cts_occupancy > (1.0 + 1.0e-9)} {
  error "V5 post-CTS effective site occupancy exceeds 100%: $_hima_post_cts_occupancy"
}
puts "=== CCFMAX V5 POST-CTS EFFECTIVE OCCUPANCY @@ARM@@ $_hima_post_cts_occupancy ==="
setNanoRouteMode -routeWithTimingDriven true
setNanoRouteMode -envResistanceFromCapTable true
routeDesign -globalDetail
setExtractRCMode -engine postRoute -effortLevel medium
extractRC
puts "=== CCFMAX PRE-OPT TIMING @@ARM@@ ==="
timeDesign -postRoute -outDir @@RPT_DIR@@/preopt -prefix pre
setOptMode -fixFanoutLoad true
optDesign -postRoute -setup
set _hima_final_occupied_area [_hima_standard_cell_area]
set _hima_final_effective_occupancy [expr {$_hima_final_occupied_area / $_hima_core_area}]
if {$_hima_final_effective_occupancy > (1.0 + 1.0e-9)} {
  error "V5 final effective site occupancy exceeds 100%: $_hima_final_effective_occupancy"
}
set _hima_physical_facts [open {@@PHYSICAL_FACTS@@} w]
puts $_hima_physical_facts "metric\tvalue\tunit"
puts $_hima_physical_facts "occupied_standard_cell_area\t$_hima_final_occupied_area\tum2"
puts $_hima_physical_facts "core_area\t$_hima_core_area\tum2"
puts $_hima_physical_facts "effective_site_occupancy\t$_hima_final_effective_occupancy\tfraction"
puts $_hima_physical_facts "dcap_count\t$_hima_dcap_count\tcount"
puts $_hima_physical_facts "pg_special_wire_count\t[llength [dbGet top.nets.sWires]]\tcount"
close $_hima_physical_facts
reportDensityMap > {@@DENSITY_REPORT@@}
puts "=== CCFMAX V5 FINAL EFFECTIVE OCCUPANCY @@ARM@@ $_hima_final_effective_occupancy ==="
# Fmax is the primary objective. Hold remains an observed secondary result,
# but this Campaign never spends post-route optimization effort repairing it
# at the expense of setup timing.

# Ordinary filler and DCAP are not inserted in this Campaign.
puts "=== CCFMAX V5 NO ORDINARY FILLER @@ARM@@ ==="
puts "=== CCFMAX V5 NO DCAP INSERTION @@ARM@@ ==="

extractRC
puts "=== CCFMAX POST-OPT SETUP @@ARM@@ ==="
timeDesign -postRoute -outDir @@RPT_DIR@@/postopt -prefix post -numPaths 100 -expandReg2Reg -pathreports
# Endpoint-complete V5 timing state. This is distinct from the bounded
# human-readable path report above: every register data endpoint is named and
# asked independently, so another path can take over without disappearing from
# the next research generation.
set _hima_endpoint_index [open {@@ENDPOINT_INDEX@@} w]
puts $_hima_endpoint_index "# endpoint"
set _hima_setup_endpoints [lsort [get_object_name [all_registers -data_pins]]]
foreach _hima_endpoint $_hima_setup_endpoints { puts $_hima_endpoint_index $_hima_endpoint }
close $_hima_endpoint_index
file delete -force {@@ENDPOINT_REPORT@@}
set _hima_active_view [lindex [all_analysis_views] 0]
foreach _hima_endpoint $_hima_setup_endpoints {
  report_timing -late -to [get_pins $_hima_endpoint] -max_paths 1 -nworst 1 \
    -net -view $_hima_active_view >> {@@ENDPOINT_REPORT@@}
}
puts "=== CCFMAX V5 SETUP ENDPOINTS @@ARM@@ [llength $_hima_setup_endpoints] ==="
puts "=== CCFMAX POST-OPT HOLD @@ARM@@ ==="
timeDesign -postRoute -hold -outDir @@RPT_DIR@@/posthold -prefix hold
# Export the active post-route constraints from this Innovus session. This command
# still requires the planned real-Site L4 bring-up on Innovus 23.14; local fixture
# coverage proves only the adapter/evidence contract.
write_sdc @@POSTROUTE_SDC@@
set_default_switching_activity -input_activity @@SWITCHING_ACTIVITY@@
report_power    > @@RPT_DIR@@/power.rpt
reportGateCount > @@RPT_DIR@@/gatecount.rpt
summaryReport -noHtml -outfile @@RPT_DIR@@/summary.rpt
verify_drc -limit 100000 -report @@RPT_DIR@@/route.drc.rpt
verifyConnectivity -type all -report @@RPT_DIR@@/connectivity.rpt

saveNetlist @@POSTROUTE_NETLIST@@
saveDesign @@FINAL_DB@@
streamOut @@GDS_OUT@@ \
  -mapFile @@GDS_MAP@@ \
  -libName @@DESIGN_TOP@@ -merge [list @@MERGE_GDS@@] -units 1000 -mode ALL
puts "=== CCFMAX PNR DONE @@ARM@@ (GDS written) ==="
exit
