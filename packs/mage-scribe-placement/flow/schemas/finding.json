{
  "type": "object",
  "required": [
    "schema", "id", "round", "snapshotSha256", "consumer", "consumerModel",
    "evaluatorReceipt", "targets", "predicate", "status", "severity", "numbers", "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "mage.finding/1"},
    "id": {"type": "string", "minLength": 1, "pattern": "^F-(litho-pie|metrology|alignment|wat)-[0-9]+$"},
    "round": {"type": "integer", "minimum": 0},
    "snapshotSha256": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "consumerModel": {"type": "string", "minLength": 1},
    "evaluatorReceipt": {"type": "string"},
    "targets": {"type": "array", "items": {"type": "string"}},
    "predicate": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["pass", "fail", "unknown"]},
    "severity": {"type": "string", "enum": ["hard", "cost", "info"]},
    "numbers": {"type": "object"},
    "explanation": {"type": "string"}
  }
}
