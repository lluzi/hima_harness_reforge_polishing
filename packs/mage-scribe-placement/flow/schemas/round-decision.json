{
  "type": "object",
  "required": [
    "schema", "id", "round", "route", "nextRound", "best", "openRequests",
    "decisionRequests", "history", "stopReason"
  ],
  "additionalProperties": false,
  "$defs": {
    "nextRound": {
      "type": "object",
      "required": ["round"],
      "additionalProperties": false,
      "properties": {"round": {"type": "integer", "minimum": 0}}
    }
  },
  "properties": {
    "schema": {"type": "string", "const": "mage.round-decision/1"},
    "id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 0},
    "route": {"type": "string", "enum": ["continue", "stop"]},
    "nextRound": {"$ref": "#/$defs/nextRound"},
    "best": {"type": ["object", "null"]},
    "openRequests": {"type": "array"},
    "decisionRequests": {"type": "array"},
    "history": {"type": "array"},
    "stopReason": {"type": "string"},
    "skippedReviews": {"type": "array"},
    "nativeAnchor": {"type": ["object", "null"]},
    "goalRules": {"type": "object"},
    "goalMetThisRound": {"type": "boolean"}
  }
}
