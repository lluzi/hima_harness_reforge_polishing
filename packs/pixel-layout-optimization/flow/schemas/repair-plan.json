{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pixel.repair-plan/1",
 "title": "pixel.repair-plan/1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "round",
  "hypothesis",
  "repairs"
 ],
 "properties": {
  "schema": {
   "const": "pixel.repair-plan/1"
  },
  "round": {
   "type": "integer",
   "minimum": 1
  },
  "hypothesis": {
   "type": "string",
   "minLength": 1
  },
  "repairs": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "candidate",
     "edits"
    ],
    "properties": {
     "candidate": {
      "type": "string",
      "minLength": 1
     },
     "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "layer"
       ],
       "anyOf": [
        {
         "required": [
          "dx",
          "dy"
         ]
        },
        {
         "required": [
          "op",
          "box"
         ]
        }
       ],
       "properties": {
        "layer": {
         "type": "string",
         "minLength": 1
        },
        "polygon": {
         "type": "integer",
         "minimum": 0
        },
        "vertices": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 0
         }
        },
        "edge": {
         "type": "integer",
         "minimum": 0
        },
        "dx": {
         "type": "number",
         "minimum": -1.5,
         "maximum": 1.5
        },
        "dy": {
         "type": "number",
         "minimum": -1.5,
         "maximum": 1.5
        },
        "op": {
         "enum": [
          "add",
          "cut"
         ]
        },
        "box": {
         "type": "array",
         "minItems": 4,
         "maxItems": 4,
         "items": {
          "type": "number"
         }
        }
       }
      }
     },
     "expect": {
      "type": "string"
     }
    }
   }
  }
 }
}
