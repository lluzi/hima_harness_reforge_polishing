{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1}
      }
    },
    "readerValue": {
      "type": "object",
      "required": ["type", "unit", "value"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "unknownReason": {"type": "string"}
      }
    },
    "observation": {
      "type": "object",
      "required": ["contentSha256", "values"],
      "properties": {
        "contentSha256": {"type": "string", "minLength": 1},
        "values": {"type": "array", "items": {"$ref": "#/$defs/readerValue"}}
      }
    },
    "resident-output": {
      "type": "object",
      "required": ["observations", "engineering"],
      "properties": {
        "observations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "engineering": {
          "type": "object",
          "required": ["outcome", "summary", "stopReason"],
          "properties": {
            "outcome": {"type": "string", "enum": ["completed", "best-effort", "blocked"]},
            "summary": {"type": "string"},
            "stopReason": {"type": "string"}
          }
        }
      }
    },

    "goal-fields": {
      "type": "object",
      "properties": {
        "TARGET_DROPPED": {"type": "number"},
        "MAX_TARGET_DISTANCE_UM": {"type": "number"},
        "MAX_ORDER_DEVIATION_LR": {"type": "number"},
        "MAX_ORDER_DEVIATION_TB": {"type": "number"},
        "MAX_PRIORITY_MOVE_UM": {"type": "number"}
      }
    },

    "prepare-case-input": {
      "type": "object",
      "required": ["MAGE_CASE_MANIFEST", "SITE_CAPABILITIES", "TARGET_DROPPED", "MAX_TARGET_DISTANCE_UM", "MAX_ORDER_DEVIATION_LR", "MAX_ORDER_DEVIATION_TB", "MAX_PRIORITY_MOVE_UM"],
      "properties": {
        "MAGE_CASE_MANIFEST": {"type": "string", "minLength": 1},
        "SITE_CAPABILITIES": {"type": "string", "minLength": 1},
        "TARGET_DROPPED": {"type": "number"},
        "MAX_TARGET_DISTANCE_UM": {"type": "number"},
        "MAX_ORDER_DEVIATION_LR": {"type": "number"},
        "MAX_ORDER_DEVIATION_TB": {"type": "number"},
        "MAX_PRIORITY_MOVE_UM": {"type": "number"}
      }
    },
    "prepare-case-output": {
      "type": "object",
      "required": ["MAGE_CASE_MANIFEST", "SITE_CAPABILITIES", "readinessId", "startSnapshotSha256"],
      "properties": {
        "MAGE_CASE_MANIFEST": {"type": "string"},
        "SITE_CAPABILITIES": {"type": "string"},
        "readinessId": {"type": "string", "minLength": 1},
        "startSnapshotSha256": {"type": "string", "minLength": 1}
      }
    },

    "measure-incumbent-input": {
      "type": "object",
      "required": ["CASE", "INCUMBENT_COMPARISON"],
      "properties": {
        "CASE": {"$ref": "#/$defs/prepare-case-output"},
        "INCUMBENT_COMPARISON": {"type": "string", "enum": ["retained", "native"]}
      }
    },
    "measure-incumbent-output": {
      "type": "object",
      "required": ["incumbentId", "snapshotSha256", "metrics", "ordinaryPopulation", "evidence", "nativeRequested"],
      "properties": {
        "incumbentId": {"type": "string", "minLength": 1},
        "snapshotSha256": {"type": "string", "minLength": 1},
        "metrics": {"type": "object"},
        "ordinaryPopulation": {"type": "integer", "minimum": 0},
        "evidence": {"type": "string", "const": "modelled"},
        "nativeRequested": {"type": "boolean"}
      }
    },

    "engineer-script-input": {
      "type": "object",
      "required": ["ROUND", "SITE_CAPABILITIES", "TARGET_DROPPED", "MAX_TARGET_DISTANCE_UM", "MAX_ORDER_DEVIATION_LR", "MAX_ORDER_DEVIATION_TB", "MAX_PRIORITY_MOVE_UM"],
      "properties": {
        "ROUND": {"type": "integer", "minimum": 1},
        "SITE_CAPABILITIES": {"type": "string", "minLength": 1},
        "TARGET_DROPPED": {"type": "number"},
        "MAX_TARGET_DISTANCE_UM": {"type": "number"},
        "MAX_ORDER_DEVIATION_LR": {"type": "number"},
        "MAX_ORDER_DEVIATION_TB": {"type": "number"},
        "MAX_PRIORITY_MOVE_UM": {"type": "number"}
      }
    },

    "decide-round-input": {
      "type": "object",
      "required": ["ROUND", "CANDIDATE", "TARGET_DROPPED", "MAX_TARGET_DISTANCE_UM", "MAX_ORDER_DEVIATION_LR", "MAX_ORDER_DEVIATION_TB", "MAX_PRIORITY_MOVE_UM"],
      "properties": {
        "ROUND": {"type": "integer", "minimum": 1},
        "CANDIDATE": {"$ref": "#/$defs/resident-output"},
        "TARGET_DROPPED": {"type": "number"},
        "MAX_TARGET_DISTANCE_UM": {"type": "number"},
        "MAX_ORDER_DEVIATION_LR": {"type": "number"},
        "MAX_ORDER_DEVIATION_TB": {"type": "number"},
        "MAX_PRIORITY_MOVE_UM": {"type": "number"}
      }
    },
    "decide-round-output": {
      "type": "object",
      "required": ["route", "nextRound", "best", "stopReason", "goalMet", "rules", "journalEntries"],
      "properties": {
        "route": {"type": "string", "enum": ["continue", "stop"]},
        "nextRound": {
          "type": "object",
          "required": ["round"],
          "properties": {"round": {"type": "integer", "minimum": 0}}
        },
        "best": {"type": ["object", "null"]},
        "stopReason": {"type": "string"},
        "goalMet": {"type": "boolean"},
        "rules": {"type": "object"},
        "journalEntries": {"type": "integer", "minimum": 0}
      }
    },

    "evaluate-placement-input": {
      "type": "object",
      "required": ["DECISION", "INCUMBENT", "TARGET_DROPPED", "MAX_TARGET_DISTANCE_UM", "MAX_ORDER_DEVIATION_LR", "MAX_ORDER_DEVIATION_TB", "MAX_PRIORITY_MOVE_UM"],
      "properties": {
        "DECISION": {"$ref": "#/$defs/decide-round-output"},
        "INCUMBENT": {"$ref": "#/$defs/measure-incumbent-output"},
        "TARGET_DROPPED": {"type": "number"},
        "MAX_TARGET_DISTANCE_UM": {"type": "number"},
        "MAX_ORDER_DEVIATION_LR": {"type": "number"},
        "MAX_ORDER_DEVIATION_TB": {"type": "number"},
        "MAX_PRIORITY_MOVE_UM": {"type": "number"}
      }
    },
    "evaluate-placement-output": {
      "type": "object",
      "required": ["goalMet", "metrics", "incumbent", "comparison", "rules", "unknowns", "proofLevel", "domainReport"],
      "properties": {
        "goalMet": {"type": "boolean"},
        "metrics": {"type": "object"},
        "incumbent": {"type": "object"},
        "comparison": {"type": "object"},
        "rules": {"type": "object"},
        "unknowns": {"type": "array"},
        "proofLevel": {"type": "string", "enum": ["none", "reproduction", "improvement", "match", "surpass", "completion"]},
        "domainReport": {"type": "object"}
      }
    },

    "deliver-input": {
      "type": "object",
      "required": ["EVALUATION"],
      "properties": {"EVALUATION": {"$ref": "#/$defs/evaluate-placement-output"}}
    },
    "deliver-output": {
      "type": "object",
      "required": ["goalMet", "proofLevel", "reportPath", "packagePath"],
      "properties": {
        "goalMet": {"type": "boolean"},
        "proofLevel": {"type": "string", "enum": ["none", "reproduction", "improvement", "match", "surpass", "completion"]},
        "reportPath": {"type": "string", "minLength": 1},
        "packagePath": {"type": "string", "minLength": 1}
      }
    }
  }
}
