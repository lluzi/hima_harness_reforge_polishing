#!/usr/bin/env python3
"""Stand-in `podman` for the custom-cell-fmax-sky130-demo dry path (no container, no EDA).

Answers exactly the calls flow/cellfmax_cli.py makes:

  podman image inspect --format {{.Id}} <image>   prints IMAGE_ID (the Site binds this same id)
  podman run ... -v <dir>:/work:rw ... -lc 'bash /work/inputs/orfs_arm.sh'
      writes the ORFS outputs the Pack reads (6_report.json, 5_2_route.json, 6_final.v,
      top-paths.txt) under <dir> for the CELLFMAX_VARIANT it was given, and exits 0
  podman run ... -c '<script calling flow/toolbox/char/characterize.py>'
      the characterize step, per characterize.py call (extracted and/or pre-layout): creates the
      calibration when the script would calibrate (it is missing), then writes <out>/characterization.json
      (every job cell `ok`) and <out>/custom.measured.lib (custom.modelled.lib for --netlist-kind
      pre-layout) with one minimal cell group per job cell (the job's pins, footprint
      and functions, which characterize took from the foundry cell for a drop-in variant); exit 0
  podman run ... klayout ...                       no-op, exit 0 (cell image rendering)
  podman stop ...                                  exit 0

The worst setup slack is a function of how many custom cells the run may use: a custom cell is
usable when the run's custom LEF (/work/inputs/custom.lef: the Pack writes only the characterized
cells into it, the same cells its merged characterized Liberty adds) declares it, it is not in the run's
DONT_USE_CELLS, and its name does not contain `_SLOW` (a cell the placer never picks, which is how
the convergence scenario's rounds add nothing). 0 usable cells give the stock -0.249301 ns, 1 gives
-0.10 ns, 2 or more give 0.0 ns, so every round gain is hand-computable from 1000 / (3.6 - WNS).
Every call is appended to $CELLFMAX_PODMAN_LOG when it is set.
"""
import json
import os
import re
import shlex
import sys
from pathlib import Path

IMAGE_ID = "c8e8a7a41e3da6fc9a14c8b4b3303df836ffe24b03d9a96fc91c8c1e76827667"
STOCK_WNS = -0.249301
STOCK_TNS = -1.91346
STOCK_INSTANCES = 37939
WNS_BY_USABLE = {0: STOCK_WNS, 1: -0.10}
INSTANCES_PER_CUSTOM_CELL = 7


def log(argv):
    target = os.environ.get("CELLFMAX_PODMAN_LOG")
    if target:
        try:
            with open(target, "a") as stream:
                stream.write(json.dumps(argv) + "\n")
        except OSError:
            pass


def run_orfs(argv):
    env, work = {}, None
    for index, word in enumerate(argv):
        if word == "-e" and index + 1 < len(argv) and "=" in argv[index + 1]:
            key, value = argv[index + 1].split("=", 1)
            env[key] = value
        if word == "-v" and index + 1 < len(argv) and argv[index + 1].endswith(":/work:rw"):
            work = Path(argv[index + 1][: -len(":/work:rw")])
    if work is None or "CELLFMAX_VARIANT" not in env:
        print("podman stand-in: no /work mount or CELLFMAX_VARIANT", file=sys.stderr)
        return 125
    variant = env["CELLFMAX_VARIANT"]
    dont_use = set(env.get("CELLFMAX_VAR_DONT_USE_CELLS", "").split())
    lef = work / "inputs" / "custom.lef"
    declared = re.findall(r"(?m)^\s*MACRO\s+(\S+)\s*$", lef.read_text()) if lef.is_file() else []
    usable = [name for name in declared if name not in dont_use and "_SLOW" not in name]
    wns = WNS_BY_USABLE.get(len(usable), 0.0)
    tns = STOCK_TNS if not usable else round(STOCK_TNS * wns / STOCK_WNS, 5)
    instances = STOCK_INSTANCES + INSTANCES_PER_CUSTOM_CELL * len(usable)
    logs = work / "logs" / "sky130hd" / "aes" / variant
    results = work / "results" / "sky130hd" / "aes" / variant
    logs.mkdir(parents=True, exist_ok=True)
    results.mkdir(parents=True, exist_ok=True)
    (logs / "6_report.json").write_text(json.dumps({
        "finish__timing__setup__ws": wns, "finish__timing__setup__tns": tns,
        "finish__design__instance__count": instances, "finish__design__instance__area": 405000.0,
        "finish__power__total": 0.0912,
    }))
    (logs / "5_2_route.json").write_text(json.dumps({"detailedroute__route__drc_errors": 0}))
    lines = ["module aes_cipher_top (clk);", " input clk;", " wire n1;",
             " sky130_fd_sc_hd__nand2_1 _1_ (.A(a), .B(b), .Y(n1));",
             " sky130_fd_sc_hd__dfxtp_1 _2_ (.CLK(clk), .D(n1), .Q(q));"]
    for name in usable:
        for index in range(INSTANCES_PER_CUSTOM_CELL):
            lines.append(" %s _c%s_%d_ (.A(a), .B(b), .C(c), .Y(n%d));" % (name, name.lower(), index, index + 10))
    lines.append("endmodule")
    (results / "6_final.v").write_text("\n".join(lines) + "\n")
    first = usable[0] if usable else "sky130_fd_sc_hd__nor3_1"
    (work / "top-paths.txt").write_text(
        "Startpoint: _2_ (rising edge-triggered flip-flop clocked by clk)\n"
        "Endpoint: u_sbox/_9_/D (rising edge-triggered flip-flop clocked by clk)\n"
        "   0.40    0.40 ^ _2_/Q (sky130_fd_sc_hd__dfxtp_1)\n"
        "   0.30    0.70 v _c1_/Y (%s)\n"
        "   0.20    0.90 ^ _1_/Y (sky130_fd_sc_hd__nand2_1)\n"
        "           0.90   data arrival time\n\n"
        "  %.3f   slack (%s)\n\n" % (first, wns, "MET" if wns >= 0 else "VIOLATED"))
    print("== podman stand-in ORFS variant=%s usable=%s wns=%s" % (variant, ",".join(usable) or "-", wns))
    return 0


def _after(words, flag):
    return words[words.index(flag) + 1] if flag in words and words.index(flag) + 1 < len(words) else None


def measured_cell(cell):
    """A minimal Liberty cell group for one job cell: its pins, footprint and functions, no tables."""
    pins = cell["pins"]
    lines = ['    cell ("%s") {' % cell["name"], "        area : %s;" % (cell.get("area_um2") or 10.0),
             '        cell_footprint : "%s";' % cell["footprint"],
             '        pg_pin ("%s") { pg_type : "primary_ground"; voltage_name : "%s"; }' % (pins["ground"], pins["ground"]),
             '        pg_pin ("%s") { pg_type : "primary_power"; voltage_name : "%s"; }' % (pins["power"], pins["power"])]
    lines += ['        pin ("%s") { direction : "input"; capacitance : 0.002; }' % pin for pin in pins["inputs"]]
    lines += ['        pin ("%s") { direction : "output"; function : "%s"; timing () { related_pin : "%s"; } }'
              % (pin, cell["functions"][pin], pins["inputs"][0]) for pin in pins["outputs"]]
    return "\n".join(lines + ["    }", ""])


def run_characterize(script):
    """Every characterize.py call of the script (extracted and/or pre-layout), each with its own job."""
    words = shlex.split(script)
    starts = [i for i, w in enumerate(words) if w.endswith("/characterize.py")]
    if not starts:
        print("podman stand-in: characterize script without characterize.py: %r" % script, file=sys.stderr)
        return 125
    for n, at in enumerate(starts):
        # each call ends where the next calibrate/characterize begins; its calibrate.py precedes it
        tail = words[at + 1:starts[n + 1] if n + 1 < len(starts) else len(words)]
        job_path = tail[0] if tail else None
        out, calibration = _after(tail, "--out"), _after(tail, "--calibration")
        kind = _after(tail, "--netlist-kind") or "extracted"
        if job_path is None or out is None or calibration is None:
            print("podman stand-in: characterize call without job, --out or --calibration: %r" % script, file=sys.stderr)
            return 125
        calibration = Path(calibration)
        if any(w.endswith("/calibrate.py") for w in words) and not calibration.is_file():
            calibration.parent.mkdir(parents=True, exist_ok=True)
            calibration.write_text(json.dumps({"schema": "stand-in-calibration", "netlistKind": kind, "firstJob": job_path}) + "\n")
        job = json.loads(Path(job_path).read_text())
        out = Path(out)
        out.mkdir(parents=True, exist_ok=True)
        cells = job.get("cells", [])
        stem = "custom.modelled" if kind == "pre-layout" else "custom.measured"
        (out / (stem + ".lib")).write_text(
            "library (cellfmax_characterized) {\n    delay_model : \"table_lookup\";\n    time_unit : \"1ns\";\n"
            + "".join(measured_cell(cell) for cell in cells) + "}\n")
        (out / "characterization.json").write_text(json.dumps({
            "cells": [{"name": cell["name"], "status": "ok", "reason": None} for cell in cells], "netlistKind": kind,
            "method": "podman stand-in (no ngspice)", "calibration": str(calibration), "refused": None,
        }))
        print("== podman stand-in characterize %d %s cell(s)" % (len(cells), kind))
    return 0


def main(argv):
    log(argv)
    if argv[:2] == ["image", "inspect"]:
        print(IMAGE_ID)
        return 0
    if argv[:1] == ["stop"]:
        return 0
    if argv[:1] == ["run"]:
        if any("klayout" in word for word in argv):
            return 0
        if any("orfs_arm.sh" in word for word in argv):
            return run_orfs(argv)
        script = _after(argv, "-c")
        if script is not None and "characterize.py" in script:
            return run_characterize(script)
    print("podman stand-in: unsupported call %r" % (argv,), file=sys.stderr)
    return 125


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
