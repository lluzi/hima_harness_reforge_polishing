#!/bin/sh
# Static checks use fresh exported types, including on a checkout without lib/.
# There is no lint step: this repository ships no lint tool.
set -e
[ -d "$HOME/.local/node24/bin" ] && PATH="$HOME/.local/node24/bin:$PATH"
node scripts/require-node.mjs
pnpm run check:seams
pnpm run check:boundary
pnpm run build
pnpm run typecheck
pnpm run test:unit
